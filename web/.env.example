# ── Auth (NextAuth v5 / Auth.js) ─────────────────────────────────────────────
# Generate a secret: `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth client (from Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
#                          http://localhost:3000/api/auth/callback/google (dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Restrict sign-in to one Google Workspace domain (leave blank in dev to allow any).
ALLOWED_EMAIL_DOMAIN=urbandistrict.com

# Dev-only: enables a one-click "Enter (dev login)" button so you can open and
# explore the app WITHOUT setting up Google OAuth. Ignored when NODE_ENV=production.
# Leave unset/false for any real/shared deployment.
AUTH_DEV_LOGIN=true

# ── Database (Postgres — Vercel Postgres / Supabase / Neon) ───────────────────
# Any Postgres connection string. Used by the app at request time and by drizzle-kit.
DATABASE_URL=

# ── Data sources (server-side only — added as each connector is wired) ────────
# Shopify Admin API (Phase 2)
SHOPIFY_STORE=
SHOPIFY_TOKEN=
# GA4, Google Ads, Meta, Anthropic — added in later phases.
